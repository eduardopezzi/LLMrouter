# Set this to protect /v1/* and /admin/* endpoints.
LLMROUTER_SERVER__API_KEY=
# Increase to distribute concurrent requests across multiple CPU cores.
LLMROUTER_SERVER__WORKERS=1

# When running in Docker on macOS/Windows, host.docker.internal reaches Ollama on the host.
LLMROUTER_PROVIDERS__OLLAMA__BASE_URL=http://host.docker.internal:11434
LLMROUTER_EVALUATOR__OLLAMA__BASE_URL=http://host.docker.internal:11434
# Optional when Ollama is behind an authenticated proxy.
# OLLAMA_API_KEY=

# Local model catalog. This file is ignored by git and created from
# config/models.example.yaml when missing.
LLMROUTER_MODELS_FILE=config/models.yaml

# Catálogo local de benchmarks atualizado por job agendado, nunca por requisição.
# LLMROUTER_BENCHMARKS__CATALOG_PATH=data/model_benchmarks.yaml
# LLMROUTER_BENCHMARKS__SOURCES_PATH=data/benchmark_sources.yaml
# LLMROUTER_BENCHMARKS__REFRESH_ENABLED=true
# LLMROUTER_BENCHMARKS__REFRESH_INTERVAL_HOURS=168
# LLMROUTER_BENCHMARKS__REFRESH_TIMEOUT_SECONDS=30

# Optional fallback provider keys.
# ZAI_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=

# Optional PRecog observation publishing.
# LLMROUTER_PRECOG__ENABLED=false
# LLMROUTER_PRECOG__BASE_URL=http://localhost:8888
# LLMROUTER_PRECOG__API_KEY=
# Authentication aliases accepted for compatibility with PRecog:
# PRECOG_INTERNAL_API_KEY=
# LLMROUTER_OBSERVATION_API_KEY=
# LLMROUTER_PRECOG__PROJECT=llmrouter

# Semantic prompt routing (sentence-transformers + embeddings). Set enabled=true to activate.
# LLMROUTER_SEMANTIC__ENABLED=true
# LLMROUTER_SEMANTIC__MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# LLMROUTER_SEMANTIC__DEVICE=cpu
# LLMROUTER_SEMANTIC__BENCHMARK_KNOWLEDGE_BASE_PATH=benchmark_knowledge_base.py
# LLMROUTER_SEMANTIC__BENCHMARK_SIMILARITY_THRESHOLD=0.30
# LLMROUTER_SEMANTIC__BENCHMARK_TOP_K=5
# LLMROUTER_ROUTING__DYNAMIC_BENCHMARK_ROUTING=true
# LLMROUTER_HYBRID__RULE_WEIGHT=0.3
# LLMROUTER_HYBRID__SEMANTIC_WEIGHT=0.7
# LLMROUTER_HYBRID__SEMANTIC_CONFIDENCE_THRESHOLD=0.35
